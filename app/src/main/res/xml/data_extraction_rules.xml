<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is backed up by Android (Google backup) except per-device sync settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device.xml" />
    </device-transfer>
</data-extraction-rules>
